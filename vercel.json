{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{fonts,assets,public}/**",
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/login.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
