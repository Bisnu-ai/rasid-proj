# Copy this file to ".env" and fill in real values. Never commit ".env".

# MongoDB Atlas connection string (Free Tier cluster). Include a database name, e.g. /durga_puja
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/durga_puja?retryWrites=true&w=majority

# Long random string (32+ chars) used to sign login sessions.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000
NODE_ENV=production

# Login session length in hours (default 8)
SESSION_HOURS=8

# Set to 1 when deployed behind a proxy/host such as Render, Railway or Nginx
# (needed for correct client IPs in login rate limiting).
# TRUST_PROXY=1
